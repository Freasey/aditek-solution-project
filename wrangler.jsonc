{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worksell-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Variabel dan secret yang diisi lewat dashboard (Workers > worksell-web > Settings >
  // Variables and Secrets) tidak dihapus saat deploy.
  "keep_vars": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worksell_db",
      "database_id": "1d630403-ebe8-4f60-a449-09b7324cef25",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    // 5 request per 60 detik per IP untuk POST /api/leads
    { "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // 5 percobaan login admin per 60 detik per IP
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  "vars": {
    "SITE_URL": "https://worksell.id",
    // "on" setelah Image Transformations aktif di zone worksell.id
    "IMAGE_TRANSFORMS": "off"
  }
  // Diisi pemilik di dashboard (lihat README):
  //   BLOB_READ_WRITE_TOKEN (secret)  token Vercel Blob
  //   ADMIN_EMAIL                     email login admin
  //   ADMIN_PASSWORD (secret)         password login admin
  //   PUBLIC_TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY (opsional, anti-spam form)
}
