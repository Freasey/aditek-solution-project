---
import { env } from 'cloudflare:workers';
import { desc } from 'drizzle-orm';
import Admin from '../../layouts/Admin.astro';
import { getDb } from '../../db/client';
import { media } from '../../db/schema';
import { imageUrl, mediaUrl } from '../../lib/media';
import { formatDate } from '../../lib/util';

const items = await getDb(env).select().from(media).orderBy(desc(media.createdAt)).limit(500);
const kb = (n: number) => (n > 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.round(n / 1024)} KB`);
---
<Admin title="Media">
  <div class="bar"><h1>Media</h1><p>Foto disimpan di R2. File tidak pernah ditimpa: ganti foto berarti upload baru.</p></div>
  <section class="panel">
    <h2>Upload</h2>
    <form class="af" method="post" action="/api/admin/media" enctype="multipart/form-data" id="upload-form">
      <div class="drop" data-drop>
        <p>Tarik foto ke sini, atau pilih file.</p>
        <input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple required />
        <p class="hint">JPEG, PNG, WebP, atau AVIF. Maksimal 10 MB per file.</p>
      </div>
      <div class="row">
        <label>Folder
          <select name="folder"><option value="projects">Proyek</option><option value="systems">Kartu sistem</option><option value="site">Website (OG image, lain-lain)</option></select>
        </label>
        <label>Alt text<input type="text" name="alt" maxlength="200" placeholder="Deskripsi singkat isi foto" /></label>
      </div>
      <input type="hidden" name="width" /><input type="hidden" name="height" />
      <div class="actions"><button class="btn btn--accent btn--sm" type="submit">Upload</button><span class="hint" data-status role="status"></span></div>
    </form>
  </section>
  {items.length === 0 ? <p class="muted">Belum ada foto.</p> : (
    <ul class="media-grid">
      {items.map((m) => (
        <li class="media-card">
          <a class="thumb" data-slot={m.id} href={mediaUrl(env, m.r2Key)} target="_blank" rel="noopener"><img src={imageUrl(env, m.r2Key, 480)} alt={m.alt} loading="lazy" /></a>
          <span class="meta">{m.width && m.height ? `${m.width}×${m.height} · ` : ''}{kb(m.bytes)} · {formatDate(m.createdAt)}</span>
          <form class="af" method="post" action={`/api/admin/media/${m.id}`}>
            <label class="hint">Alt text<input type="text" name="alt" value={m.alt} maxlength="200" /></label>
            <button class="btn btn--quiet btn--sm" type="submit">Simpan alt</button>
          </form>
          <form method="post" action={`/api/admin/media/${m.id}/delete`} data-confirm="Hapus foto ini dari R2?">
            <button class="btn btn--danger btn--sm" type="submit">Hapus</button>
          </form>
        </li>
      ))}
    </ul>
  )}
</Admin>

<script>
  import { uploadImage } from '../../scripts/upload';

  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm ?? 'Lanjutkan?')) e.preventDefault();
    }),
  );

  const form = document.querySelector<HTMLFormElement>('#upload-form');
  if (form) {
    const drop = form.querySelector<HTMLElement>('[data-drop]')!;
    const input = form.querySelector<HTMLInputElement>('input[type=file]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    ['dragenter', 'dragover'].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault();
        drop.classList.add('is-over');
      }),
    );
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('is-over')));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      if (e.dataTransfer?.files.length) input.files = e.dataTransfer.files;
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const files = [...(input.files ?? [])];
      if (!files.length) return;
      const data = new FormData(form);
      let done = 0;
      try {
        for (const file of files) {
          status.textContent = `Mengunggah ${done + 1} dari ${files.length}...`;
          await uploadImage(file, String(data.get('folder')), String(data.get('alt') ?? ''));
          done++;
        }
        location.href = `/admin/media?ok=${encodeURIComponent(`${done} foto diunggah.`)}`;
      } catch (err) {
        status.textContent = (err instanceof Error ? err.message : 'Upload gagal.') + (done ? ` (${done} berhasil)` : '');
      }
    });
  }
</script>
