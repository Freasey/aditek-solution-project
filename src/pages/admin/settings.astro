---
import { env } from 'cloudflare:workers';
import { desc } from 'drizzle-orm';
import Admin from '../../layouts/Admin.astro';
import MediaPicker from '../../components/admin/MediaPicker.astro';
import { getDb } from '../../db/client';
import { media } from '../../db/schema';
import { getSettings } from '../../lib/content';

const db = getDb(env);
const [s, mediaItems] = await Promise.all([getSettings(db), db.select().from(media).orderBy(desc(media.createdAt)).limit(200)]);
---
<Admin title="Pengaturan">
  <div class="bar"><div><h1>Pengaturan</h1><p>Perubahan langsung tampil di website tanpa deploy ulang.</p></div></div>
  <form class="af panel" method="post" action="/api/admin/settings">
    <h2>Kontak</h2>
    <div class="row">
      <label>Nomor WhatsApp
        <input type="tel" name="whatsapp_number" maxlength="30" value={s.whatsapp_number} placeholder="0812 3456 7890" />
        <span class="hint">Tujuan form kontak. Disimpan dalam format 62...</span>
      </label>
      <label>Email kontak
        <input type="email" name="contact_email" maxlength="200" value={s.contact_email} placeholder="halo@worksell.id" />
        <span class="hint">Dipakai bila pengunjung memilih email.</span>
      </label>
    </div>
    <label>Janji balasan<input type="text" name="reply_promise" required maxlength="120" value={s.reply_promise} /></label>
    <h2>Teks website</h2>
    <label>Judul utama (H1) di Home<input type="text" name="hero_title" required maxlength="120" value={s.hero_title} /></label>
    <label>Slogan footer<input type="text" name="footer_line" required maxlength="120" value={s.footer_line} /></label>
    <MediaPicker name="og_image_id" label="OG image (gambar saat link dibagikan, ideal 1200×630)" value={s.og_image_id || null} items={mediaItems} folder="site" />
    <div class="actions"><button class="btn btn--accent btn--sm" type="submit">Simpan pengaturan</button></div>
  </form>
</Admin>
