# Salin ke .dev.vars untuk development lokal. File .dev.vars tidak boleh di-commit.
SITE_URL=http://localhost:4321
IMAGE_TRANSFORMS=off
# Login admin lokal
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ganti-password-lokal
# Kosongkan supaya foto disimpan di D1 lokal (khusus development).
# Isi dengan token Vercel Blob bila ingin mencoba upload sungguhan.
BLOB_READ_WRITE_TOKEN=
# Opsional. Key uji resmi Turnstile (selalu lolos), atau kosongkan untuk mematikan Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
